{
    "manifest_version": 3,
    "default_locale": "en",
    "name": "__MSG_extension_name__",
    "description": "__MSG_extension_description__",
    "version": "1.0",
    "icons": {
        "48": "images/icon-48.png",
        "96": "images/icon-96.png",
        "128": "images/icon-128.png",
        "256": "images/icon-256.png",
        "512": "images/icon-512.png"
    },
    "background": {
        "scripts": [
            "background.js"
        ],
        "type": "module",
        "persistent": false
    },
    "content_scripts": [
        {
            "js": [
                "page.js",
                "winfull.js"
            ],
            "matches": [
                "*://*.youtube.com/*"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": true
        },
        {
            "js": [
                "defaults.js",
                "content.js",
                "content-playback.js",
                "content-volume.js",
                "content-quality.js",
                "content-autoplay.js",
                "content-player.js",
                "content-shorts.js",
                "content-appearance.js",
                "content-page.js",
                "content-shortcuts.js",
                "content-sponsors.js",
                "content-feeds.js",
                "content-ads.js",
                "content-ui.js"
            ],
            "css": [
                "content.css"
            ],
            "matches": [
                "*://*.youtube.com/*"
            ],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "action": {
        "default_icon": "images/toolbar-icon.svg"
    },
    "permissions": [
        "storage",
        "cookies"
    ],
    "browser_specific_settings": {
        "safari": {
            "strict_min_version": "17.0"
        }
    },
    "options_ui": {
        "page": "options.html"
    },
    "host_permissions": [
        "*://*.youtube.com/*"
    ],
    "optional_host_permissions": [
        "https://sponsor.ajay.app/*",
        "https://returnyoutubedislikeapi.com/*"
    ]
}
